{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "dockerfilePath": "monolith/Dockerfile",
        "dockerfileContext": "monolith"
    },
    "deploy": {
        "startCommand": "gunicorn --bind 0.0.0.0:$PORT app:app",
        "restartPolicyType": "ON_FAILURE"
    }
}